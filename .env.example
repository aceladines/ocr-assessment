# Nanonets / Docstrange API Configuration
NANONETS_API_KEY=your_nanonets_api_key_here

# Inbound auth: if set, every /extract endpoint requires header `X-API-Key: <this>`.
# Leave empty only for trusted local/dev use.
API_AUTH_KEY=

# App settings (secure defaults: DEBUG off, bind loopback)
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Performance / Concurrency
MAX_CONCURRENT_REQUESTS=5

# Upload limits (DoS guards)
MAX_UPLOAD_FILES=50
MAX_UPLOAD_SIZE_MB=10

# Directories
OUTPUT_DIR=outputs
UPLOAD_DIR=temp_uploads

# Folder-scan confinement: /extract/folder paths must resolve inside this dir.
# Defaults to the project root when unset.
ALLOWED_SCAN_DIR=

# Mock Mode (Set to True to test end-to-end without spending real Nanonets API credits)
MOCK_OCR=False
